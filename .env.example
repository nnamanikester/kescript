# ── Required ────────────────────────────────────────────────────────────────
# Fine-grained personal access token. Repository access: nnamanikester/kescript.
# Permissions: Issues (read-only), Metadata (read-only).
# Raises GitHub's rate limit from 60 to 5,000 requests/hour and powers the
# public comment thread.
GITHUB_TOKEN=

# Your production URL (used for canonical links, feeds, OG images).
NEXT_PUBLIC_SITE_URL=https://kescript.com

# ── Comments & reactions (GitHub sign-in) ───────────────────────────────────
# From the GitHub App you create (see README → "Turn on native comments").
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Encrypts the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Only for a classic OAuth App instead of a GitHub App:
# GITHUB_OAUTH_SCOPE=public_repo

# ── Optional ────────────────────────────────────────────────────────────────
# Instant publishing: same value as the webhook secret on GitHub.
GITHUB_WEBHOOK_SECRET=
# Writer AI (title/tags/description wands, "Ask AI" on selected text).
# Set one key. AI_MODEL is optional for Anthropic (default claude-sonnet-5-5)
# and Gemini (default gemini-3.8-flash). With several keys set, AI_PROVIDER
# (anthropic | gemini | openai) picks one.
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AI_PROVIDER=
# …or OpenAI (Responses API), or any server that speaks it: OPENAI_API_KEY and/or AI_BASE_URL, plus AI_MODEL.
# OPENAI_API_KEY=
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=
# GoatCounter site code (the "kescript" in kescript.goatcounter.com): counts
# visits and shows unique views on posts. Turn on Settings → "Allow adding
# visitor counts on your website".
NEXT_PUBLIC_GOATCOUNTER_CODE=
# Buttondown username, if you start a newsletter (free tier).
NEXT_PUBLIC_BUTTONDOWN_USERNAME=
# Google Search Console → Add property → HTML tag method: paste only the
# content="…" value here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
